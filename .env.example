APP_NAME=NamibWay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=namibway
DB_USERNAME=namibway
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The lodge-facing booking system on its own host. Absent — as here — the
# partner panel answers under /partner exactly as before, which is what local
# development and CI want. Setting it needs a DNS record, a certificate and an
# nginx server block first, plus SESSION_DOMAIN=.namibway.com so a login is
# shared across both hosts — see DEPLOYMENT.md, "Buchungs-Subdomain".
#
# Deliberately left commented out rather than set empty: the panel binds its
# routes while booting, so a test that needs the host on has to put it in the
# environment before the application is created — and a key present in .env,
# even with an empty value, is a key that can overwrite it.
# BOOKING_PANEL_DOMAIN=booking.namibway.com

# The team mailbox, used with plus-addressing: a demo tenant addresses
# everything as team+<lodge-slug>@namibway.com, so it can send real mail
# through the normal mailer and still only ever reach us — and the tag says
# which lodge each message is about.
BOOKING_TEAM_ADDRESS=team@namibway.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_SALES_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared inbox polled for partner/listing replies (see namibway:fetch-partner-emails)
POP3_HOST=
POP3_PORT=995
POP3_ENCRYPTION=ssl
POP3_USERNAME=team@namibway.com
POP3_PASSWORD=
POP3_VALIDATE_CERT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANTHROPIC_API_KEY=

# Places API (legacy) — Find Place + Place Details + Place Photo, used by
# namibway:fetch-google-photos to source real photos for imageless listings.
# Needs a Google Cloud project with billing enabled; leave empty to disable.
GOOGLE_PLACES_API_KEY=

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=namibway
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub-<hash>.r2.dev  # Enable "Public Access" on the bucket in Cloudflare dashboard

# Image thumbnails via Cloudflare Image Transformations. Off by default: it only
# works once CLOUDFLARE_R2_URL points at a CUSTOM DOMAIN on the namibway.com zone
# (a pub-<hash>.r2.dev URL cannot serve /cdn-cgi/image/) and Transformations are
# enabled for that zone. While it's off every image is served at its original
# size — see DEPLOYMENT.md → "Bild-Thumbnails" for the switch-on checklist.
MEDIA_TRANSFORMS_ENABLED=false
MEDIA_TRANSFORMS_QUALITY=80

# Separate, NON-public R2 bucket for DB backups — do NOT enable public access
# or attach a custom domain to this bucket, it holds password hashes + emails.
# Leave the access-key vars empty to reuse CLOUDFLARE_R2_ACCESS_KEY_ID/SECRET above,
# or set dedicated ones if using a bucket-scoped API token.
CLOUDFLARE_R2_BACKUP_BUCKET=namibway-backups
CLOUDFLARE_R2_BACKUP_ACCESS_KEY_ID=
CLOUDFLARE_R2_BACKUP_SECRET_ACCESS_KEY=
BACKUP_NOTIFICATION_EMAIL=till.merle@gmail.com
BACKUP_ARCHIVE_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Defaults to the public OSRM demo server if unset — only set this to point at
# a self-hosted OSRM instance.
OSRM_BASE_URL=

VITE_APP_NAME="${APP_NAME}"
