APP_NAME=NamibWay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=namibway
DB_USERNAME=namibway
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_SALES_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared inbox polled for partner/listing replies (see namibway:fetch-partner-emails)
POP3_HOST=
POP3_PORT=995
POP3_ENCRYPTION=ssl
POP3_USERNAME=team@namibway.com
POP3_PASSWORD=
POP3_VALIDATE_CERT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ANTHROPIC_API_KEY=

# Places API (legacy) — Find Place + Place Details + Place Photo, used by
# namibway:fetch-google-photos to source real photos for imageless listings.
# Needs a Google Cloud project with billing enabled; leave empty to disable.
GOOGLE_PLACES_API_KEY=

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=namibway
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://pub-<hash>.r2.dev  # Enable "Public Access" on the bucket in Cloudflare dashboard

# Separate, NON-public R2 bucket for DB backups — do NOT enable public access
# or attach a custom domain to this bucket, it holds password hashes + emails.
# Leave the access-key vars empty to reuse CLOUDFLARE_R2_ACCESS_KEY_ID/SECRET above,
# or set dedicated ones if using a bucket-scoped API token.
CLOUDFLARE_R2_BACKUP_BUCKET=namibway-backups
CLOUDFLARE_R2_BACKUP_ACCESS_KEY_ID=
CLOUDFLARE_R2_BACKUP_SECRET_ACCESS_KEY=
BACKUP_NOTIFICATION_EMAIL=till.merle@gmail.com
BACKUP_ARCHIVE_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

VITE_APP_NAME="${APP_NAME}"
